<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bohuai.ocs.mapper.UserMapper">

    <sql id="cols">id, email, password_hash, display_name, role, created_at</sql>

    <select id="findById" resultType="com.bohuai.ocs.model.User">
        SELECT <include refid="cols"/> FROM users WHERE id = #{id}
    </select>

    <select id="findByEmail" resultType="com.bohuai.ocs.model.User">
        SELECT <include refid="cols"/> FROM users WHERE email = #{email}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (email, password_hash, display_name, role)
        VALUES (#{email}, #{passwordHash}, #{displayName}, #{role})
    </insert>
</mapper>
