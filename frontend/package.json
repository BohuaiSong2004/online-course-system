{
  "name": "ocs-frontend",
  "private": true,
  "description": "Micro-frontend web app for the Online Course Management System (Next.js multi-zones)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n shell,catalog,learn,studio,admin -c blue,green,magenta,yellow,cyan \"npm:dev -w @ocs/shell\" \"npm:dev -w @ocs/catalog\" \"npm:dev -w @ocs/learn\" \"npm:dev -w @ocs/studio\" \"npm:dev -w @ocs/admin\"",
    "build": "npm run build --workspaces --if-present",
    "start": "concurrently -n shell,catalog,learn,studio,admin \"npm:start -w @ocs/shell\" \"npm:start -w @ocs/catalog\" \"npm:start -w @ocs/learn\" \"npm:start -w @ocs/studio\" \"npm:start -w @ocs/admin\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.29",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.73.0"
  }
}